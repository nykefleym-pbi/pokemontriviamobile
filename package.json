{
  "name": "pokemontriviamobile",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:edge",
    "typecheck:edge": "tsc -p supabase/functions/tsconfig.json",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "bundle:edge": "node scripts/bundle-edge-function.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2"
  }
}
