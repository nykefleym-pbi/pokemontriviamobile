    "./level-curve": "./src/lib/level-curve.ts",
    "./gym-leaders": "./src/lib/gym-leaders.ts",
    "./elite-four": "./src/lib/elite-four.ts",
    "./whos-that": "./src/lib/whos-that.ts",
    "./items": "./src/content/items/index.ts",
    "./rewards": "./src/lib/rewards/index.ts",
    "./game-data": "./src/lib/game-data.ts",
    "./daily-gift": "./src/lib/daily-gift.ts",
    "./mega": "./src/engine/mega-replay.ts",
    "./mega-replay": "./src/engine/mega-battle-replay.ts"
